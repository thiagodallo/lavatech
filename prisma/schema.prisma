generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model agendamento {
  id                  Int                  @id @default(autoincrement())
  cliente_id          Int
  veiculo_id          Int
  servico_id          Int
  funcionario_id      Int                  @default(-1)
  vaga_id             Int
  data_hora_agendada  DateTime             @db.Timestamp(6)
  data_hora_inicio    DateTime?            @db.Timestamp(6)
  data_hora_fim       DateTime?            @db.Timestamp(6)
  status              String               @db.VarChar(20)
  observacoes         String?
  criado_em           DateTime             @default(now()) @db.Timestamp(6)
  atualizado_em       DateTime?            @db.Timestamp(6)
  cliente             cliente              @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  funcionario         funcionario          @relation(fields: [funcionario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  servico             servico              @relation(fields: [servico_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vaga_lavagem        vaga_lavagem         @relation(fields: [vaga_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  veiculo             veiculo              @relation(fields: [veiculo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checklist_qualidade checklist_qualidade?
  historico_status    historico_status[]
  pagamento           pagamento?

  @@index([cliente_id], map: "idx_agendamento_cliente_id")
  @@index([data_hora_agendada], map: "idx_agendamento_data_hora_agendada")
  @@index([funcionario_id], map: "idx_agendamento_funcionario_id")
  @@index([servico_id], map: "idx_agendamento_servico_id")
  @@index([status], map: "idx_agendamento_status")
  @@index([vaga_id], map: "idx_agendamento_vaga_id")
  @@index([veiculo_id], map: "idx_agendamento_veiculo_id")
}

model checklist_qualidade {
  id                   Int         @id @default(autoincrement())
  agendamento_id       Int         @unique
  funcionario_id       Int
  hora_inicio          DateTime?   @db.Timestamp(6)
  hora_fim             DateTime?   @db.Timestamp(6)
  houve_problema       Boolean     @default(false)
  descricao_problema   String?
  necessita_retrabalho Boolean     @default(false)
  agendamento          agendamento @relation(fields: [agendamento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  funcionario          funcionario @relation(fields: [funcionario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([funcionario_id], map: "idx_checklist_funcionario_id")
}

model cliente {
  id          Int           @id @default(autoincrement())
  nome        String        @db.VarChar(150)
  telefone    String        @unique @db.VarChar(20)
  email       String?       @db.VarChar(150)
  criado_em   DateTime      @default(now()) @db.Timestamp(6)
  agendamento agendamento[]
  veiculo     veiculo[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model funcionario {
  id                   Int                    @id @default(autoincrement())
  nome                 String                 @db.VarChar(150)
  email                String?                @unique @db.VarChar(150)
  senha_hash           String?                @db.VarChar(255)
  papel                String                 @db.VarChar(20)
  ativo                Boolean                @default(true)
  criado_em            DateTime               @default(now()) @db.Timestamp(6)
  agendamento          agendamento[]
  checklist_qualidade  checklist_qualidade[]
  historico_status     historico_status[]
  movimentacao_estoque movimentacao_estoque[]
}

model historico_status {
  id              Int         @id @default(autoincrement())
  agendamento_id  Int
  status_anterior String?     @db.VarChar(20)
  status_novo     String      @db.VarChar(20)
  alterado_por    Int         @default(-1)
  alterado_em     DateTime    @default(now()) @db.Timestamp(6)
  agendamento     agendamento @relation(fields: [agendamento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  funcionario     funcionario @relation(fields: [alterado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([agendamento_id], map: "idx_historico_agendamento_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model movimentacao_estoque {
  id             Int         @id @default(autoincrement())
  produto_id     Int
  tipo           String      @db.VarChar(10)
  quantidade     Decimal     @db.Decimal(10, 2)
  data           DateTime    @default(now()) @db.Timestamp(6)
  funcionario_id Int
  observacao     String?
  funcionario    funcionario @relation(fields: [funcionario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produto        produto     @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([funcionario_id], map: "idx_movimentacao_funcionario_id")
  @@index([produto_id], map: "idx_movimentacao_produto_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pagamento {
  id              Int         @id @default(autoincrement())
  agendamento_id  Int         @unique
  valor           Decimal     @db.Decimal(10, 2)
  forma_pagamento String      @db.VarChar(20)
  status          String      @db.VarChar(20)
  pago_em         DateTime?   @db.Timestamp(6)
  agendamento     agendamento @relation(fields: [agendamento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model produto {
  id                   Int                    @id @default(autoincrement())
  nome                 String                 @db.VarChar(100)
  categoria            String?                @db.VarChar(50)
  unidade_medida       String?                @db.VarChar(10)
  quantidade_atual     Decimal                @default(0) @db.Decimal(10, 2)
  quantidade_minima    Decimal                @default(0) @db.Decimal(10, 2)
  movimentacao_estoque movimentacao_estoque[]
}

model servico {
  id              Int           @id @default(autoincrement())
  nome            String        @db.VarChar(100)
  descricao       String?
  preco           Decimal       @db.Decimal(10, 2)
  duracao_minutos Int
  ativo           Boolean       @default(true)
  agendamento     agendamento[]
}

model vaga_lavagem {
  id            Int           @id @default(autoincrement())
  identificacao String        @db.VarChar(50)
  ativo         Boolean       @default(true)
  agendamento   agendamento[]
}

model veiculo {
  id          Int           @id @default(autoincrement())
  cliente_id  Int
  placa       String        @unique @db.VarChar(10)
  marca       String?       @db.VarChar(50)
  modelo      String?       @db.VarChar(50)
  cor         String?       @db.VarChar(30)
  agendamento agendamento[]
  cliente     cliente       @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cliente_id], map: "idx_veiculo_cliente_id")
}
